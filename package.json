{
  "name": "actos",
  "version": "0.1.0",
  "description": "Official TypeScript and Node.js SDK for the Actos platform",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:types": "tsx scripts/generate-types.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.4.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/actos-dev/node.git"
  }
}
